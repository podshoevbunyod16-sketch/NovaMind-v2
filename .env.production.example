# ══════════════════════════════════════════════════════════════════
# NovaMind · production-окружение (шаблон)
# ──────────────────────────────────────────────────────────────────
# Скопируйте в .env.production и подставьте свои значения:
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Файл .env.production в git не попадает. Запуск — обычный Python, Docker не нужен:
#
#   .venv/bin/python scripts/preflight.py      # проверка
#   .venv/bin/python app.py                   # gunicorn через Python-API
#   .venv/bin/python scripts/deploy.py         # обновление одной командой
# ══════════════════════════════════════════════════════════════════

NOVA_ENV=production
PORT=5000
SITE_URL=https://your-domain.example
TRUST_PROXY=1

# ── Секреты (сгенерируйте свои) ───────────────────────────────────
# openssl rand -base64 24
ADMIN_CODE=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_КОД_НЕ_КОРОЧЕ_16
SESSION_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_32_СИМВОЛА
# Общий секрет подписи квитанций (обязателен при нескольких узлах).
RECEIPT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_32_СИМВОЛА

# ── Данные ────────────────────────────────────────────────────────
NOVA_DB_PATH=/data/novamind_chats.db
KNOWLEDGE_DB=/data/knowledge.db
TRACE_DIR=/data/traces

# ── Модель ────────────────────────────────────────────────────────
# Достаточно одного бесплатного ключа. Без ключей чат работает офлайн.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# ── Фирменные подсистемы ──────────────────────────────────────────
RECEIPTS_ENABLED=1
COUNCIL_SEATS=3
COUNCIL_TIMEOUT=90
COUNCIL_RATE_USER=60
COUNCIL_RATE_GUEST=10

# ── Наблюдаемость ─────────────────────────────────────────────────
NOVA_ACCESS_LOG=1
NOVA_LOG_JSON=0
LOG_LEVEL=INFO
# Если задан, /metrics требует токен: /metrics?token=… или X-Metrics-Token.
METRICS_TOKEN=

# ── Python-сервер (app.py, server.py и gunicorn.conf.py) ─────────
# Один процесс-писатель: SQLite и лимиты в памяти рассчитаны на 1 воркер.
WEB_CONCURRENCY=1
WEB_THREADS=8
WEB_TIMEOUT=180
WEB_GRACEFUL_TIMEOUT=30
WEB_KEEPALIVE=65
WEB_MAX_REQUESTS=2000
# 0 — приложение импортируется в каждом воркере (фоновые потоки живут);
# 1 — предзагрузка в master (планировщик поднимается в post_fork).
WEB_PRELOAD=0

# ── Безопасность и лимиты ─────────────────────────────────────────
# Песочницу включайте только в изолированном контейнере.
TERMINAL_ENABLED=0
AGENT_RATE_USER=200
AGENT_RATE_GUEST=30
GUARDRAILS_ENABLED=1
