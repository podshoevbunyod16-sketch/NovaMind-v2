# Flask
FLASK_ENV=development
FLASK_DEBUG=True
# Секрет сессий. Без него ключ генерируется заново при каждом старте и все
# входы «слетают» после перезапуска.
SESSION_SECRET=change-me-please
LOG_LEVEL=INFO
# Внешний адрес сервиса (нужен для OAuth, Referer и абсолютных ссылок).
SITE_URL=http://localhost:5000
PORT=5000

# ══════════ Вход ══════════
# Администратор. Если ADMIN_CODE не задан, при старте генерируется
# одноразовый код и печатается в лог (дефолтного «007» больше нет).
ADMIN_USER=admin
# ADMIN_CODE=задайте-свой
# Локальный вход как администратор по нику (только для запросов с 127.0.0.1 / ::1).
# ОПАСНО при публикации через туннель (ngrok, cloudflared, ssh -R) или обратный прокси!
# ADMIN_NICKS=Bunyod,admin_local
# SETTINGS_OPEN_TO_ALL=0 — 1 открывает панель настроек (/settings) всем посетителям.
#   ВНИМАНИЕ: тогда любой сможет менять провайдера, модель, локальный сервер и навыки.
#   MCP-подключения остаются только за администратором.
SETTINGS_OPEN_TO_ALL=0

# Google OAuth (кнопка «Войти через Google»). Redirect URI должен совпадать
# с тем, что указан в Google Cloud Console, иначе обмен кода вернёт ошибку.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

# Необязательно: cloud-провайдеры
# GROQ_API_KEY=...
# CEREBRAS_API_KEY=...
# OPENROUTER_API_KEY=...

# Google AI Studio / Gemini API
# GEMINI_API_KEY=...
# Дополнительные бесплатные модели Google через запятую (ID из AI Studio):
# GOOGLE_EXTRA_FREE_MODELS=ID-модели-1,ID-модели-2
# GEMINI_MODEL=gemini-2.0-flash  # FIX: была опечатка gemini-3.8-flash

# OpenAI-compatible сервер.
# Работает с Ollama, LM Studio, vLLM, LocalAI и удалёнными endpoint'ами.
# Для llama.cpp llama-server используйте OpenAI-compatible API на порту 8080:
# http://127.0.0.1:8080/v1
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama3.2

# OpenAI как отдельный провайдер (выбирается в настройках, как Groq/OpenRouter).
# Платный: без OPENAI_ALLOW_PAID=1 модели скрыты, чтобы не тратить деньги случайно.
# Использует тот же OPENAI_API_KEY; адрес облака по умолчанию https://api.openai.com/v1.
# OPENAI_ALLOW_PAID=1
# OPENAI_CLOUD_URL=https://api.openai.com/v1

# Допустимые альтернативные имена:
# AI_BASE_URL=https://your-host.example.com/v1
# AI_API_KEY=your-key
# AI_MODEL=your-model
# LOCAL_LLM_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_API_KEY=
# Pollinations.ai — единый провайдер текста, vision, изображений, аудио и видео
# Каталог моделей публичный, но генерация через unified API требует ключ Pollinations.
# Получить ключ: https://enter.pollinations.ai/
# Рекомендуется хранить секретный ключ только на сервере.
# POLLINATIONS_API_KEY=sk_...
# Алиасы для совместимости:
# POLLINATIONS_KEY=sk_...
# POLLINATIONS_TOKEN=sk_...

# LOCAL_LLM_MODEL=local-model

# Аудио: OpenAI/Groq-compatible transcription и TTS
# AUDIO_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
# AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# AUDIO_TTS_URL=https://api.openai.com/v1/audio/speech
# AUDIO_TTS_MODEL=tts-1
# AUDIO_API_KEY=

# Изображения: свой OpenAI-совместимый сервис (цена зависит от вашего endpoint).
# IMAGE_GENERATION_URL=https://api.openai.com/v1/images/generations
# Правка исходника (multipart: image, prompt, model, size, n); необязательно.
# IMAGE_EDIT_URL=https://api.openai.com/v1/images/edits
# IMAGE_MODEL=gpt-image-1
# IMAGE_API_KEY=

# Видео: универсальный endpoint конкретного video-провайдера
# ВАЖНО: подтверждённого бесплатного API для генерации видео сейчас нет
# (Veo доступен только на платном тарифе Gemini API), поэтому видео-модель
# подключается явно через свой endpoint и в каталоге помечается «цена не подтверждена».
# VIDEO_API_URL=https://your-video-provider.example/v1/videos
# VIDEO_MODEL=your-video-model
# VIDEO_API_KEY=

# ══════════ Единая панель медиа-моделей (изображения / аудио / видео) ══════════
# Каталог строится из подключённых провайдеров:
#   * GEMINI_API_KEY  → Google AI Studio (TTS бесплатно; image/video — платно)
#   * GROQ_API_KEY    → Groq /v1/audio/speech, модели Orpheus (бесплатный тариф с лимитами)
#   * OPENROUTER_API_KEY → живой каталог OpenRouter, цены берутся из ответа API
#   * POLLINATIONS_API_KEY → генерация через Pollinations (не нужен для просмотра публичного каталога)
# Платные модели и модели с неподтверждённой ценой автоматически не используются:
# их нужно выбрать вручную с явным подтверждением в интерфейсе.
# Премиум-модели Pollinations (кредиты Pollen):
# POLLINATIONS_TOKEN=

# Параметры сервера
HOST=0.0.0.0
PORT=5000

# ══════════ Поиск в интернете ══════════
# Порядок поисковых бэкендов (перебираются до первой успешной выдачи):
#   weather, searxng, ddg, wiki
# Погода работает через Open-Meteo без ключа; ddg использует httpx + BeautifulSoup4.
# SEARCH_BACKENDS=weather,searxng,ddg,wiki
# Somon.tj — только для объявлений; не включается автоматически.
# SEARCH_BACKENDS=sites,weather,searxng,ddg,wiki
# SITES_SEARCH_AUTO=0
#
# Свои инстансы SearXNG (через запятую) — например, собственный docker:
# SEARXNG_INSTANCES=http://127.0.0.1:8888,https://searx.be
#
# Зеркала MediaWiki API для бэкенда wiki:
# WIKI_API_BASES=https://ru.wikipedia.org/w/api.php,https://en.wikipedia.org/w/api.php
#
# Таймауты (секунды):
# SEARCH_TIMEOUT=9          — поисковый бэкенд
# READER_TIMEOUT=10         — чтение найденных страниц
# SEARCH_MAX_PAGES=3        — сколько страниц успеваем прочитать до ответа
# SEARCH_QUERY_TIMEOUT=10   — служебные запросы к модели (поисковый запрос и т.п.)
# ANSWER_TIMEOUT=180        — ответ модели по найденным источникам.
#                             Больше, потому что у reasoning-моделей первый токен идёт долго.
#
# Ключи коммерческих поисковых API (необязательно):
# APILAYER_KEY=
# SERPER_KEY=

# ══════════ Маленький Linux: песочница, терминал, задачи ══════════
# Выключено по умолчанию. После включения доступно любому, кто вошёл
# в аккаунт: через Google, другой OAuth или по нику (серверная сессия
# ставится автоматически при входе). Админом быть не обязательно.
# TERMINAL_STRICT_ADMIN=1 — если нужен прежний режим «только администратор».
# TERMINAL_REQUIRE_GOOGLE=1 — пускать в песочницу только проверенный Google-вход
#   (по умолчанию достаточно любого входа, команды всё равно в песочнице).
# Песочница — это папка проекта с белым списком команд и лимитами,
# а не полноценный shell: |, >, &&, sudo и выход за пределы папки запрещены.
# TERMINAL_ENABLED=1
#
# Где живёт рабочая папка (по умолчанию ./workspace рядом с app.py):
# TERMINAL_DIR=/var/lib/novamind/workspace
#
# Лимиты терминала:
# TERMINAL_TIMEOUT=20      — секунд на одну команду
# TERMINAL_MAX_OUTPUT=12000 — символов вывода (остальное обрезается)

# ══════════ ИИ-агент в главном чате ══════════
# Модель решает: ответить или вызвать инструмент; читает результат и решает заново.
# В главном чате «Инструменты» (#btn-web-search) — разрешение, а не команда искать.
# В новом браузере выключены. Выключено = ни поиска, ни терминала, ни медиа от агента.
# «Изображения» — Авто/точный выбор модели и редактирование в том же чате.
# Отдельная кнопка озвучки под ответом не требует подключения Linux.
# AGENT_ENABLED=1
# AGENT_MAX_STEPS=20       — общий лимит инструментальных шагов за один запрос
# AGENT_MAX_TOKENS=4096    — лимит токенов на ОДИН ответ модели в агентном режиме.
#                            Ограничивается сверху лимитом выбранного провайдера.
#                            Маленькое значение обрывает ответ на полуслове;
#                            движок тогда дописывает его до конца отдельным запросом.
# AGENT_TIMEOUT=240        — общий лимит времени на ответ
# AGENT_STEP_TIMEOUT=30    — лимит на одну команду в Linux
# AI_NATIVE_TOOLS=1        — 0: разрешённые схемы передаются текстом вместо native tools.
# Если локальный OpenAI-compatible сервер отклоняет tools, запрос повторяется со
# схемами JSON-действий; выбранная языковая модель не заменяется автоматически.
# AGENT_AUTO_TOOLS=0        — 1: включать автоподбор инструментов и MCP-серверов по цели
#                            (браузер отправляет auto_tools: true для включённых инструментов)
# AUTO_TOOLS_STRICT=0        — 1: жёстко сужать меню инструментов и каталог MCP
# AUTO_TOOLS_MAX_LOCAL=10    — максимум локальных инструментов в strict-режиме
# AUTO_MCP_SERVERS=3         — максимум MCP-серверов в рекомендации
# AUTO_MCP_TOOLS_PER_SERVER=6
# AUTO_MCP_TOOLS_TOTAL=12
# AGENT_CONFIRM=danger     — спрашивать разрешение: danger | write (и write-шаги) | off.
# AGENT_CONFIRM_TIMEOUT=120 — сколько секунд ждать ответа, дальше — отказ.
# MEMORY_ENABLED=1         — долгосрочная память (только для вошедших; гостям выключена).
#
# Защита от перебора пароля админки (этап 7):
# ADMIN_LOGIN_MAX_ATTEMPTS=5 — сколько неудачных попыток разрешено
# ADMIN_LOGIN_WINDOW=600     — окно в секундах (10 минут); блок отдельно по IP и по аккаунту
#
# Лимит запросов к агенту (этап 7):
# AGENT_RATE_LIMIT=1         — 0 полностью выключает ограничение
# AGENT_RATE_GUEST=30        — запросов в час для гостя
# AGENT_RATE_USER=200        — запросов в час для вошедшего
# AGENT_RATE_WINDOW=3600     — окно в секундах
#
# Задачи по расписанию (бонус Б4):
# SCHEDULER_ENABLED=1        — фоновый поток, который выполняет задания
# SCHEDULER_TICK=30          — как часто проверять, кому пора (секунды)
# Задания ставятся агентом (инструмент schedule) или через POST /api/schedule:
#   {"prompt": "сводка новостей", "cron": "0 9 * * *"}
#   {"prompt": "проверь сайт", "every": "30m"}
# Результаты приходят в отдельный чат «⏰ Расписание».
#
# Telegram-бот (бонус Б5). Токен берётся ТОЛЬКО отсюда — в коде его нет.
# Запуск отдельным процессом: python telegram_bot.py
# TELEGRAM_BOT_TOKEN=123456:AA...
# TELEGRAM_ENABLED=1            — 0 временно выключает бота
# TELEGRAM_ALLOWED_USERS=        — id через запятую; пусто — пускаем всех
# TELEGRAM_POLL_TIMEOUT=25       — сколько секунд ждать обновления (long polling)
#
# Инструменты: search, open, image, audio, video, media_models — всегда;
# run, read, write, ls — только с TERMINAL_ENABLED=1.
#
# Модель генерации медиа агент выбирает сам: сначала свой endpoint из .env
# (IMAGE_GENERATION_URL / AUDIO_TTS_URL / VIDEO_API_URL), потом бесплатные модели
# подключённых провайдеров (Pollinations, OpenRouter :free, Gemini/Groq TTS).
# В «Авто» после отказа возможна следующая модель (до MEDIA_MAX_ATTEMPTS).
# При точном выборе пары провайдер/модель в чате замены не будет.
# Платные модели и пробные кредиты (Nano Banana, Veo) автоматически НЕ берутся —
# разрешить явно:
# MEDIA_ALLOW_PAID=1
# MEDIA_MAX_ATTEMPTS=3

# ══════════ Локальная модель без облака ══════════
# Автопоиск запущенного OpenAI-compatible сервера (llama.cpp / Ollama /
# LM Studio): если ключей нет, чат сам переключится на локальную модель.
# LOCAL_LLM_AUTODETECT=1
# Имя и контекст локальной модели (для провайдера openai_compatible):
# LOCAL_MODEL_ID=llama3.2
# LOCAL_MODEL_NAME=Local model
# LOCAL_MODEL_CONTEXT=8192

# ── Локальные модели: паритет с Groq/OpenRouter ──
# Адрес сервера задаётся здесь или в панели «Локальные модели» (там же
# проверка и список моделей). Пресет определяется по порту автоматически:
#   Ollama            http://127.0.0.1:11434/v1
#   LM Studio         http://127.0.0.1:1234/v1
#   llama.cpp         http://127.0.0.1:8080/v1
#   vLLM              http://127.0.0.1:8000/v1
#   LocalAI/Jan/KoboldCpp/text-generation-webui — см. LOCAL_MODELS.md
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# Нативный tool calling: auto (по умолчанию) | on | off.
# Если модель/сервер не принимает tools, запрос один раз повторится без них.
# LOCAL_LLM_TOOLS=auto
# Рассуждения: auto | on | off. Включает reasoning-параметры рантайма
# (reasoning_format для llama.cpp, chat_template_kwargs для vLLM, think для Ollama).
# LOCAL_LLM_REASONING=auto
# Необязательные параметры сэмплирования (как у облачных провайдеров):
# LOCAL_LLM_TOP_P=0.9
# LOCAL_LLM_SEED=42
# Стоп-последовательности разделяются || (токены вроде <|im_end|> содержат |):
# LOCAL_LLM_STOP=</s>||<|im_end|>
# LOCAL_LLM_PRESENCE_PENALTY=0
# LOCAL_LLM_FREQUENCY_PENALTY=0
# Глубокий скан каталога Ollama (/api/show для каждой модели): возможности
# tools/vision/thinking приходят от сервера, а не угадываются по имени.
# LOCAL_LLM_DEEP_SCAN=0
# Сколько секунд кэшировать каталог моделей и сколько ждать ответ сервера:
# LOCAL_LLM_CATALOG_TTL=45
# LOCAL_LLM_CATALOG_TIMEOUT=4
# Передавать usage при потоковой генерации (учёт токенов, как в облаке):
# LOCAL_LLM_STREAM_USAGE=1
# Номер ключа локального сервера, если он требует авторизацию:
# LOCAL_LLM_API_KEY=

# ══════════ MCP ══════════
# Настройки серверов хранятся в chmod 600 mcp_connections.json (не коммитить).
# На Render без постоянного диска можно передать MCP_CONNECTIONS_JSON через Environment.
# MCP_CONNECTIONS_FILE=mcp_connections.json
# MCP_TIMEOUT=12
# MCP_MAX_RETRIES=2              # транспортные повторы discovery/read-only/idempotent операций
# AGENT_TOOL_REPEAT_LIMIT=10     # максимум одинаковых вызовов MCP агентом; 1–100
# AGENT_SESSION_HISTORY_LIMIT=200 # предыдущих сообщений текущего чата для контекста; 20–1000
# MCP_MAX_CONCURRENT=4
# MCP_TOOL_CACHE_SECONDS=30
# MCP_STDIO_MAX_SESSIONS=8       # ограничивает фоновые процессы STDIO
# MCP_STDIO_IDLE_TIMEOUT=300
# MCP_STDIO_DISCOVERY_TIMEOUT=4
# MCP_ALLOW_USER_READ=0          # 1: обычным пользователям только инструменты с readOnlyHint=true
# COMPOSIO_API_KEY=

# ══════════ ReAct-инструменты кода в изолированной рабочей папке ══════════
# Доступен всем вошедшим пользователям и honours AGENT_ENABLED.
# CODING_AGENT_MAX_STEPS=20
# CODING_AGENT_TIMEOUT=600

# ══════════ Прочее ══════════
# APP_TITLE=NovaMind
# SYSTEM_PROMPT=   — дополнительная инструкция к системному промпту
# ASSISTANT_VOICE_REPLY=0
# VISION_PROVIDER=
# VISION_MODEL=
# NOVAMIND_MEDIA_DIR=generated_media
# NOVAMIND_SKILLS_DIR=user_skills
# NOVAMIND_IMAGE_DIR=generated_media
# NO_NETWORK=0

# ══════════ Озвучка ответов (TTS) ══════════
# Провайдер берётся по приоритету: уже подключённый TTS → бесплатные сервисы.
#   GEMINI_API_KEY      → Google AI Studio (Gemini TTS, 28 голосов, ru + en)
#   GROQ_API_KEY        → Groq Orpheus (бесплатно; английский и саудовский арабский,
#                         200 символов на запрос; один раз принять условия модели
#                         на https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english)
#   POLLINATIONS_API_KEY→ Pollinations Audio (каталог моделей живой: /audio/models;
#                         чат-модели с аудио-выходом идут через /v1/chat/completions)
#   AUDIO_TTS_URL       → свой OpenAI-совместимый /audio/speech
# Ключи остаются на сервере: браузер получает только готовый звук.
# TTS_MAX_CHARS=8000        — максимум текста на один запрос
# TTS_CHUNK_CHARS=900       — размер части (делим по границам предложений)
# TTS_MAX_CHUNKS=12         — сколько частей максимум озвучиваем за раз
# TTS_TIMEOUT=90            — таймаут одного запроса к провайдеру, секунды
# TTS_FILE_TTL=3600         — через сколько удалять старые файлы озвучки
# TTS_FILE_KEEP=200         — сколько последних файлов озвучки не трогать
# TTS_RATE_LIMIT=1          — 0 отключает лимит запросов на озвучку
# TTS_RATE_USER=120         — запросов в час для вошедшего пользователя
# TTS_RATE_GUEST=30         — запросов в час для гостя
# TTS_RATE_WINDOW=3600      — окно лимита в секундах

# ══════════ Ограждения агента (guardrails.py) ══════════
# Вход/выход и аргументы инструментов проверяются по умолчанию. Отключать
# целиком стоит только для отладки: без них инъекции и утечки секретов
# в ответе модели ничем не ограничены.
# GUARDRAILS_ENABLED=1
# GUARDRAIL_MAX_INPUT=24000        — максимум символов в сообщении (лишнее обрезается)
# GUARDRAIL_MAX_TOOL_ARG=60000     — максимум аргументов одного инструмента
# GUARDRAIL_INJECTION_ACTION=block — block | warn (только предупреждать)
#
# ══════════ Права инструментов (capabilities.py) ══════════
# На каждый ход выпускается HMAC-подписанный токен с точным списком
# инструментов (least-privilege). Без AGENT_CAP_SECRET подпись живёт только
# в памяти процесса (токены не переживают перезапуск — это безопасный вариант).
# AGENT_CAP_SECRET=                 — свой секрет для подписи (если нужен между процессами)
# AGENT_CAP_TTL=1800                — срок жизни токена, секунды
# AGENT_CAPABILITIES=1              — 0 отключает проверки (не рекомендуется)
#
# ══════════ База знаний / RAG (knowledge.py) ══════════
# Индекс своих документов: PDF, DOCX, XLSX, MD, TXT, CSV, JSON.
# KNOWLEDGE_DB=knowledge.db
# KNOWLEDGE_CHUNK_CHARS=900        — размер фрагмента
# KNOWLEDGE_CHUNK_OVERLAP=120      — перекрытие фрагментов
# KNOWLEDGE_MAX_FILE_MB=25         — максимум размера загружаемого файла
# KNOWLEDGE_IN_PROMPT=1            — подмешивать найденные фрагменты в промпт
#
# ══════════ Трассировка (telemetry.py) ══════════
# Один ход = одна трасса: шаги, инструменты, подтверждения, версии промптов,
# решения ограждений. Хранится локально в JSONL + отдельный файл на трассу.
# TRACING_ENABLED=1
# TRACE_DIR=traces
# TRACE_MAX_SPANS=400
# TRACE_RECENT=200
#
# ══════════ Промпты (prompt_registry.py) ══════════
# Версия промпта = sha256 текста. Закрепление версии — безопасный откат:
# PROMPT_VERSION_REACT_AGENT=<первые 12 символов sha256>

# ══════════ Production hardening (новые переменные) ══════════
# APP_ENV=production включает fail-fast проверки, HSTS и безопасные cookie.
# APP_ENV=production
# SITE_URL=https://your-domain.example
# SESSION_SECRET=минимум-32-случайных-символа
# ADMIN_CODE=минимум-12-символов-без-публикации-в-логи
# ADMIN_LEGACY_SESSIONS=0        # инвалидировать старые админ-cookie без epoch

# Заголовки и CSRF (по умолчанию совместимы со старым UI).
# CSP_STRICT=1                   # убрать unsafe-inline после миграции шаблонов
# CSRF_REQUIRE_HEADER=1          # double-submit токен из /api/csrf-token
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# COOKIE_SECURE=1
# SESSION_SAMESITE=Lax
# LOG_JSON=1                     # структурированные логи с redaction

# Лимиты загрузки и терминала.
# MAX_UPLOAD_BYTES=26214400
# TERMINAL_CPU_SECONDS=20
# TERMINAL_MEMORY_MB=1024
# TERMINAL_MAX_FILE_MB=64
# TERMINAL_RLIMIT_NPROC=0        # >0 только на выделенном UID
# AV_SCAN_COMMAND=clamscan --no-summary {path}

# Per-endpoint rate limits (in-process fallback).
# ENDPOINT_RATE_LIMIT=1
# RATE_UPLOAD=20
# RATE_TERMINAL=60
# RATE_MEDIA=30
# RATE_API=180

# Провайдеры и circuit breaker.
# PROVIDER_BREAKER_THRESHOLD=5
# PROVIDER_BREAKER_COOLDOWN=60
# MODEL_TOKEN_BUDGET=0           # 0 = без бюджета (in-memory ledger)

# Database / observability.
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/novamind
# SQLITE_DB_PATH=/var/lib/novamind/novamind_chats.db
# SANDBOX_CONTAINER=1            # обязательно при TERMINAL_ENABLED=1 в production
